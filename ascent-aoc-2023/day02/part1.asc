import { readLines } from "fs";

type Handful = { red: Int, green: Int, blue: Int };

fix parseHandful = fn(str: String): Handful => {
  fix picks = str.split(", ");
  mut handful = Handful{ red: 0, green: 0, blue: 0 };

  for pick in picks {
    fix parts = pick.split(" ");
    fix count = parts[0].toInt() ?? 0;
    fix color = parts[1];

    handful = match color {
      "red" -> handful with { red = count },
      "green" -> handful with { green = count },
      "blue" -> handful with { blue = count },
      else -> handful,
    };
  };

  handful;
};

fix parseGame = fn(line: String): List<Handful> => {
  fix handfuls = line.split(":")[1].trim().split(";");
  mut results: List<Handful> = [];

  for h in handfuls {
    results = results.append(parseHandful(h.trim()));
  };

  results;
};

fix testGame = fn(game: List<Handful>): Bool => {
  for handful in game {
    if (handful.red > 12 or handful.green > 13 or handful.blue > 14) {
      return False;
    };
  };

  True;
};

fix lines = try await readLines!("ascent-aoc-2023/day02/input.txt");

mut id = 1;
mut sum = 0;

for line in lines {
  fix game = parseGame(line);
  fix test = testGame(game);

  if (test) {
    sum = sum + id;
  };

  id = id + 1;
};

sum
